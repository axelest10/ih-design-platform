{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "ih-latam-central-identity",
  "version": 1,
  "environment": "staging",
  "protocol": {
    "name": "OpenID Connect 1.0",
    "flow": "authorization_code",
    "pkce": "S256",
    "issuer": "https://dev-hub.ihlatam.com/oidc",
    "discovery_path": "/.well-known/openid-configuration",
    "authorization_path": "/auth",
    "token_path": "/token",
    "jwks_path": "/jwks",
    "userinfo_path": "/me",
    "response_types": ["code"],
    "grant_types": ["authorization_code"],
    "id_token_signing_algorithms": ["RS256"],
    "authorization_code_ttl_seconds": 60,
    "id_token_ttl_seconds": 300,
    "access_token_ttl_seconds": 300,
    "refresh_tokens": false
  },
  "client": {
    "client_id": "ih-design-platform-staging",
    "application_type": "web",
    "token_endpoint_auth_method": "client_secret_basic",
    "redirect_uris": [
      "https://mydesign-staging.ihlatam.com/api/v1/auth/hub/callback/"
    ],
    "post_logout_redirect_uris": [],
    "scopes": ["openid", "profile", "email"]
  },
  "subject": {
    "source": "Hub User.id",
    "claim": "sub",
    "immutable": true,
    "email_is_identifier": false
  },
  "claims": {
    "required": ["sub", "email", "email_verified"],
    "optional": ["name"],
    "email_verified_type": "boolean",
    "prohibited_categories": [
      "hub_roles",
      "hub_permissions",
      "tenant_structure",
      "personnel_records",
      "organisation_data"
    ]
  },
  "relying_party_session": {
    "max_age_seconds": 900,
    "global_logout": false
  },
  "account_mapping": {
    "primary_key": "sub",
    "first_link_email_match": "exact_case_insensitive_unique_only",
    "new_account_role": "viewer",
    "preserve_existing_local_roles": true,
    "deny_inactive_local_user": true,
    "fail_closed_on_conflict": true
  }
}
