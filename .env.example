DJANGO_SECRET_KEY=
DJANGO_ENV=local
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_REQUIRE_CORPORATE_AUTH=1
CORPORATE_ALLOWED_EMAIL_DOMAINS=ihmexico.com,ihbogota.com,ihsantiago.cl,ihlima.com
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_COOKIES=0
DJANGO_HSTS_SECONDS=0

# sqlite for local development; postgresql for staging/production
DB_ENGINE=sqlite
POSTGRES_DB=ih_design
POSTGRES_USER=ih_design
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Preferred for staging/production; takes precedence over DB_ENGINE/POSTGRES_*.
DATABASE_URL=

REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=0

AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LOGIN_THROTTLE_RATE=10/hour

# Transactional email is fail-closed by default. Staging must use allowlist with
# explicit test recipients; only Production may use live delivery.
EMAIL_DELIVERY_MODE=disabled
EMAIL_ALLOWED_RECIPIENTS=
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=mydesign@ihlatam.com
POSTMARK_FROM_NAME=IH Design
POSTMARK_MESSAGE_STREAM=outbound
POSTMARK_REPLY_TO=
PASSWORD_RESET_MAX_AGE_SECONDS=900

# First production test batch: 50 designs without human approval.
# Set DESIGN_TEST_MODE=0 when the formal approval workflow is enabled.
DESIGN_TEST_MODE=1
DESIGN_TEST_LIMIT=50
