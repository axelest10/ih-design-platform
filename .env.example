DJANGO_SECRET_KEY=
DJANGO_ENV=local
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_REQUIRE_CORPORATE_AUTH=1
CORPORATE_ALLOWED_EMAIL_DOMAINS=ihmexico.com,ihbogota.com,ihsantiago.cl,ihlima.com
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_COOKIES=0
DJANGO_HSTS_SECONDS=0

# Central Hub OIDC relying party. Disabled by default. Never commit the client
# secret. Production also requires a separately reviewed approval flag.
HUB_OIDC_ENABLED=0
HUB_OIDC_PRODUCTION_APPROVED=0
HUB_OIDC_ISSUER=http://localhost:3001/oidc
HUB_OIDC_CLIENT_ID=ih-design-platform-local
HUB_OIDC_CLIENT_SECRET=
HUB_OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/hub/callback/
HUB_OIDC_SESSION_MAX_AGE_SECONDS=900
HUB_OIDC_STATE_MAX_AGE_SECONDS=600
HUB_OIDC_CLOCK_SKEW_SECONDS=30

# sqlite for local development; postgresql for staging/production
DB_ENGINE=sqlite
POSTGRES_DB=ih_design
POSTGRES_USER=ih_design
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Preferred for staging/production; takes precedence over DB_ENGINE/POSTGRES_*.
DATABASE_URL=

REDIS_URL=redis://localhost:6379/0
# Las generaciones de PDF/PPTX y copy se encolan en Celery. En staging/producción
# debe existir un worker real; con 0, sin worker las tareas permanecen en cola.
CELERY_TASK_ALWAYS_EAGER=0

# Reserved for the future IH Hub SSO integration; currently unused by the application.
IHLATAM_SSO_SECRET=

AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Fase A: 0 conserva las llamadas directas actuales; 1 activa el router sin cambiar proveedor.
AI_ROUTER_ENABLED=0
# Mantener en 0 en staging/producción hasta autorización explícita de Axel.
AI_PROMPT_IMPROVEMENT_ENABLED=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Solo evaluación con datos sintéticos/públicos; no configurar ni usar con briefs reales de IH.
GEMINI_API_KEY=
GEMINI_MODEL=
# Adaptadores registrados pero pendientes de activación explícita; no pertenecen a TASK_POLICIES.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
LOGIN_THROTTLE_RATE=10/hour

# First production test batch: 50 designs without human approval.
# Set DESIGN_TEST_MODE=0 when the formal approval workflow is enabled.
DESIGN_TEST_MODE=1
DESIGN_TEST_LIMIT=50
# Staging-only escape hatch for Axel's end-to-end approval tests. Keep 0 in production.
DESIGN_TEST_ALLOW_HUMAN_APPROVAL=0
